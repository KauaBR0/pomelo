<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- 10.0.19041 (Windows 10 2004): WinRT projections for Windows.Data.Pdf (PDF pages → images). -->
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- WPF imaging = Windows Imaging Component (WIC), the Windows counterpart of ImageIO. -->
    <UseWPF>true</UseWPF>
  </PropertyGroup>

  <ItemGroup>
    <!-- WPF SDK leaves System.IO out of implicit usings. -->
    <Using Include="System.IO" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Pomelo.Tests" />
  </ItemGroup>
</Project>
