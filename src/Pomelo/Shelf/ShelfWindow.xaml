<Window x:Class="Pomelo.Shelf.ShelfWindow" x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Pomelo — prateleira" Width="280" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False" ShowActivated="False" Topmost="True"
        AllowDrop="True" FontFamily="Segoe UI Variable Text, Segoe UI" Foreground="White">
    <Window.Resources>
        <Style x:Key="IconButton" TargetType="Button">
            <Setter Property="Foreground" Value="#B0FFFFFF" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Back" Background="Transparent" CornerRadius="6" Width="24" Height="24">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Back" Property="Background" Value="#30FFFFFF" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border x:Name="Panel" Margin="12" CornerRadius="14" Background="#F21C1C1E"
            BorderBrush="#40FFFFFF" BorderThickness="1" Padding="12,10,12,12">
        <Border.Effect>
            <DropShadowEffect BlurRadius="18" ShadowDepth="3" Opacity="0.45" />
        </Border.Effect>
        <StackPanel>
            <!-- Header: drag it to move the shelf. -->
            <DockPanel x:Name="Header" Background="Transparent" Cursor="SizeAll" Margin="0,0,0,8">
                <Button x:Name="CloseButton" DockPanel.Dock="Right" Style="{StaticResource IconButton}"
                        Content="✕" FontSize="11" ToolTip="Fechar e esvaziar a prateleira" />
                <TextBlock Text="Prateleira" FontWeight="SemiBold" FontSize="14" VerticalAlignment="Center" />
                <TextBlock x:Name="CountText" Foreground="#B0FFFFFF" FontSize="12" Margin="8,0,0,0"
                           VerticalAlignment="Center" />
            </DockPanel>

            <!-- Drag source for every available item. -->
            <Border x:Name="DragAll" CornerRadius="10" Background="#33A98BFF" BorderBrush="#A98BFF"
                    BorderThickness="1" Padding="12,10" Cursor="Hand"
                    ToolTip="Arraste para qualquer pasta ou app; os originais não saem do lugar.">
                <StackPanel>
                    <TextBlock x:Name="DragAllTitle" Text="Arraste tudo daqui" FontWeight="SemiBold" FontSize="13" />
                    <TextBlock x:Name="DragAllHint" Foreground="#B0FFFFFF" FontSize="11" Margin="0,2,0,0" TextWrapping="Wrap"
                               Text="Toque Shift, Ctrl ou Alt no caminho para usar as rodas" />
                </StackPanel>
            </Border>

            <ScrollViewer MaxHeight="264" VerticalScrollBarVisibility="Auto" Margin="0,8,0,0">
                <StackPanel x:Name="List" />
            </ScrollViewer>

            <TextBlock x:Name="Footer" Foreground="#80FFFFFF" FontSize="11" Margin="2,8,0,0" TextWrapping="Wrap"
                       Text="Solte mais arquivos aqui para guardar." />
        </StackPanel>
    </Border>
</Window>
