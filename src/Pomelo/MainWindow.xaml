<Window x:Class="Pomelo.MainWindow" x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Pomelo" Width="560" Height="420" MinWidth="420" MinHeight="300"
        WindowStartupLocation="CenterScreen">
    <DockPanel Margin="16">
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12">
            <TextBlock Text="Pomelo" FontSize="22" FontWeight="SemiBold" />
            <TextBlock TextWrapping="Wrap" Margin="0,4,0,10" Foreground="#666">
                Comece a arrastar arquivos de imagem no Explorer ou na Área de Trabalho, toque em Shift,
                e solte sobre o formato desejado. A cópia convertida é criada ao lado do original.
                Esc cancela.
            </TextBlock>
            <CheckBox x:Name="EnabledBox" Content="Ativar a roda (Shift durante o arraste)" IsChecked="True" />
        </StackPanel>
        <TextBlock DockPanel.Dock="Bottom" Margin="0,8,0,0" Foreground="#888"
                   Text="Clique duas vezes num item para mostrá-lo no Explorer." />
        <ListBox x:Name="Log" MouseDoubleClick="OnLogDoubleClick" />
    </DockPanel>
</Window>
