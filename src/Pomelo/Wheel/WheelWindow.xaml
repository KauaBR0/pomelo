<Window x:Class="Pomelo.Wheel.WheelWindow" x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wheel="clr-namespace:Pomelo.Wheel"
        Title="Pomelo" Width="380" Height="380"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False" ShowActivated="False" Topmost="True"
        Focusable="False" AllowDrop="True">
    <Grid>
        <!-- Nearly invisible disc: layered windows only hit-test pixels with alpha > 0,
             so this makes the window an OLE drop target before anything is drawn. -->
        <Ellipse Fill="#01000000" Margin="8" />
        <wheel:WheelView x:Name="View" Opacity="0" RenderTransformOrigin="0.5,0.5">
            <wheel:WheelView.RenderTransform>
                <ScaleTransform x:Name="ViewScale" />
            </wheel:WheelView.RenderTransform>
        </wheel:WheelView>
    </Grid>
</Window>
