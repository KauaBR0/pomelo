<Window x:Class="Pomelo.MainWindow" x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Pomelo" Width="600" Height="600" MinWidth="460" MinHeight="420"
        Icon="Assets/Pomelo.ico" WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <Style TargetType="GroupBox">
            <Setter Property="Margin" Value="0,0,0,12" />
            <Setter Property="Padding" Value="8" />
        </Style>
        <Style TargetType="RadioButton">
            <Setter Property="Margin" Value="0,0,0,6" />
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Margin" Value="0,0,0,6" />
        </Style>
    </Window.Resources>

    <TabControl Margin="12">
        <TabItem Header="Configurações">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="12">
                    <TextBlock x:Name="HowTo" TextWrapping="Wrap" Margin="0,0,0,14" />

                    <GroupBox Header="Rodas">
                        <StackPanel>
                            <CheckBox x:Name="WheelEnabledBox" Content="Ativar as rodas durante o arraste" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition />
                                    <RowDefinition />
                                </Grid.RowDefinitions>
                                <TextBlock Text="Converter formato:" VerticalAlignment="Center" Margin="0,0,8,4" />
                                <ComboBox x:Name="ConvertKeyBox" Grid.Column="1" Width="110" Margin="0,0,0,4" />
                                <TextBlock Grid.Row="1" Text="Ferramentas:" VerticalAlignment="Center" Margin="0,0,8,0" />
                                <ComboBox x:Name="ToolsKeyBox" Grid.Row="1" Grid.Column="1" Width="110" />
                            </Grid>
                        </StackPanel>
                    </GroupBox>

                    <GroupBox Header="Arquivos convertidos">
                        <StackPanel>
                            <RadioButton x:Name="BesideBox" GroupName="Output" Content="Ao lado do original" />
                            <RadioButton x:Name="DownloadsBox" GroupName="Output" Content="Downloads" />
                            <RadioButton x:Name="DesktopBox" GroupName="Output" Content="Área de Trabalho" />
                            <DockPanel>
                                <Button x:Name="PickFolderButton" DockPanel.Dock="Right" Content="Escolher…" Padding="10,2" Margin="8,0,0,0" />
                                <RadioButton x:Name="CustomBox" GroupName="Output" VerticalAlignment="Center">
                                    <TextBlock x:Name="CustomFolderText" TextTrimming="CharacterEllipsis" />
                                </RadioButton>
                            </DockPanel>

                            <DockPanel Margin="0,12,0,0">
                                <TextBlock Text="Qualidade JPEG:" VerticalAlignment="Center" Margin="0,0,8,0" />
                                <TextBlock DockPanel.Dock="Right" Width="32" TextAlignment="Right" VerticalAlignment="Center"
                                           Text="{Binding Value, ElementName=QualitySlider}" />
                                <Slider x:Name="QualitySlider" Minimum="1" Maximum="100" SmallChange="1" LargeChange="5"
                                        IsSnapToTickEnabled="True" TickFrequency="1" VerticalAlignment="Center" />
                            </DockPanel>
                        </StackPanel>
                    </GroupBox>

                    <GroupBox Header="Áudio e vídeo (FFmpeg)">
                        <StackPanel>
                            <TextBlock x:Name="FfmpegStatus" TextWrapping="Wrap" Margin="0,0,0,8" Text="Procurando o FFmpeg…" />
                            <WrapPanel>
                                <Button x:Name="FfmpegPickButton" Content="Escolher ffmpeg.exe…" Padding="10,2" Margin="0,0,8,4" />
                                <Button x:Name="FfmpegInstallButton" Content="Instalar com winget" Padding="10,2" Margin="0,0,8,4" />
                                <Button x:Name="FfmpegRecheckButton" Content="Procurar de novo" Padding="10,2" Margin="0,0,8,4" />
                            </WrapPanel>
                        </StackPanel>
                    </GroupBox>

                    <GroupBox Header="Sistema">
                        <StackPanel>
                            <CheckBox x:Name="StartupBox" Content="Iniciar com o Windows (direto na bandeja)" />
                            <CheckBox x:Name="NotifyBox" Content="Notificar quando a conversão terminar" />
                        </StackPanel>
                    </GroupBox>

                    <TextBlock TextWrapping="Wrap" Foreground="#777"
                               Text="Fechar esta janela mantém o Pomelo rodando na bandeja. Para encerrar, clique com o botão direito no ícone da bandeja → Sair." />
                </StackPanel>
            </ScrollViewer>
        </TabItem>

        <TabItem Header="Atividade">
            <DockPanel Margin="8">
                <TextBlock DockPanel.Dock="Bottom" Margin="0,8,0,0" Foreground="#777"
                           Text="Clique duas vezes num item para mostrá-lo no Explorer." />
                <ListBox x:Name="Log" MouseDoubleClick="OnLogDoubleClick" />
            </DockPanel>
        </TabItem>
    </TabControl>
</Window>
